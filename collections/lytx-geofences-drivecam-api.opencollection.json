{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lytx..Management.Api Consent Geofences (DriveCam) API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Geofences (DriveCam)",
        "type": "folder"
      },
      "items": [
        {
