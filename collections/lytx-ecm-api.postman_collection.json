      "item": [
        {
          "id": "490304fa-d023-49e5-b79b-dc99135422b2",
          "name": "Retrieve ECM data (V2 - Enhanced with Sample Type filtering)",
          "request": {
            "name": "Retrieve ECM data (V2 - Enhanced with Sample Type filtering)",
            "description": {
              "content": "Retrieves engine computer module (ECM) data from vehicles with enhanced filtering by sample type. ECM data availability varies by vehicle, device, and cable configuration. Also, the organization must have a Fleet Tracking subscription to receive data from this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "ecm"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "deviceIdentifier",
                  "value": "<string>",
                  "description": "Can use either device serial number or deviceId. If no device, vehicle, or group is specified, returns data for all devices."
                },
                {
                  "disabled": false,
                  "key": "vehicleIdentifier",
                  "value": "<string>",
                  "description": "Can use either VIN, vehicleId, or vehicle name. If no device, vehicle, or group is specified, returns data for all vehicles."
                },
                {
                  "disabled": false,
                  "key": "groupIdentifier",
                  "value": "<uuid>",
                  "description": "Can use groupId, rootGroupId, or group name. If no device, vehicle, or group is specified, returns data for all devices."
                },
                {
                  "disabled": false,
                  "key": "includeSubGroups",
                  "value": "false",
                  "description": "If true, all descendant groups under the specified group are included."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Record to start with."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of records to return."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "The startDate must be within the last 6 months. The startDate and endDate must be 24 hours of each other. ECM data is available for up to 7 days; DTC data is available for up to 6 months. Defaults to current UTC date."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "The startDate and endDate must be within 24 hours of each other."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Name of the property to sort on."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort direction (asc or desc)."
                },
                {
                  "disabled": false,
                  "key": "sampleType",
                  "value": "<string>",
                  "description": "(Required) Type of ECM sample data to retrieve. This parameter is required for V2 endpoint to filter specific data types."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
