          "http": {
            "method": "DELETE",
            "url": "https://api.lytx.com/consent-management/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of the vehicle to delete (GUID)."
              }
            ]
          },
          "docs": "Delete Vehicle with Specified ID"
        },
