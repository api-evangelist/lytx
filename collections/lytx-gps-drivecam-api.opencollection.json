{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lytx..Management.Api Consent GPS (DriveCam) API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "GPS (DriveCam)",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve GPS Points",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.lytx.com/consent-management/v1/gps",
            "params": [
              {
                "name": "deviceIdentifier",
                "value": "",
                "type": "query",
                "description": "Can use either device serial number or device ID."
              },
              {
                "name": "groupIdentifier",
                "value": "",
                "type": "query",
                "description": "Can use group ID or root group ID."
              },
              {
                "name": "vehicleIdentifier",
                "value": "",
                "type": "query",
                "description": "Can use either VIN or vehicle ID."
              },
              {
                "name": "includeSubGroups",
                "value": "",
                "type": "query",
                "description": "If true, all descendant groups under the specified group are included."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of records to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Record to start with."
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "The start date must be within the last 60 days."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date to filter by."
              },
              {
                "name": "dateOption",
                "value": "",
                "type": "query",
                "description": "Takes either the word createdDate or the word timeInUtc and filters trackpoints by the field specified. Default value is timeInUtc."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort direction."
              }
            ]
          },
          "docs": "Retrieve a list of GPS points for a device, vehicle, or group. The organization must have a Fleet Tracking subscription to receive data from this endpoint."
        }
      ]
    }
  ],
  "bundled": true
}