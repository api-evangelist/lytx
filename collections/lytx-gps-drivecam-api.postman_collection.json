          "name": "Retrieve GPS Points",
          "request": {
            "name": "Retrieve GPS Points",
            "description": {
              "content": "Retrieve a list of GPS points for a device, vehicle, or group. The organization must have a Fleet Tracking subscription to receive data from this endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "gps"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "deviceIdentifier",
                  "value": "<string>",
                  "description": "Can use either device serial number or device ID."
                },
                {
                  "disabled": false,
                  "key": "groupIdentifier",
                  "value": "<string>",
                  "description": "Can use group ID or root group ID."
                },
                {
                  "disabled": false,
                  "key": "vehicleIdentifier",
                  "value": "<string>",
                  "description": "Can use either VIN or vehicle ID."
                },
                {
                  "disabled": false,
                  "key": "includeSubGroups",
                  "value": "<boolean>",
                  "description": "If true, all descendant groups under the specified group are included."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of records to return."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Record to start with."
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>",
                  "description": "The start date must be within the last 60 days."
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>",
                  "description": "End date to filter by."
                },
                {
                  "disabled": false,
                  "key": "dateOption",
                  "value": "<string>",
                  "description": "Takes either the word createdDate or the word timeInUtc and filters trackpoints by the field specified. Default value is timeInUtc."
                },
                {
                  "disabled": false,
                  "key": "order",
                  "value": "<string>",
                  "description": "Sort direction."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
